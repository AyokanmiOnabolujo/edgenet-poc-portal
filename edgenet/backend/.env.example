# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://edgenet:edgenet@localhost:5432/edgenet
# Use a long random value anywhere other than your own machine.
JWT_SECRET=change-me
FRONTEND_URL=http://localhost:3000
PORT=4000
# Deadline alerts: "today" is taken in this IANA time zone, and requests ending within this many days are "due soon".
APP_TIMEZONE=Africa/Lagos
DEADLINE_WARNING_DAYS=7
